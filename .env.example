# Copy this file to .env and fill in your key.  .env is git-ignored.

# Which provider preset to use: deepseek | glm | kimi | qwen
# - deepseek : deepseek-chat        (~$0.27/M input tokens, great tool-calling)
# - glm      : glm-4-flash          (FREE tier from Zhipu AI)
# - kimi     : kimi-k2-0905-preview (Moonshot, strong agentic model, cheap)
# - qwen     : qwen-plus            (Alibaba DashScope)
PROVIDER=deepseek

# Your API key from the provider above (required for chat).
PROVIDER_API_KEY=

# Optional overrides — leave blank to use the preset defaults.
# Any OpenAI-compatible endpoint works here (OpenRouter, SiliconFlow, etc.)
PROVIDER_BASE_URL=
PROVIDER_MODEL=

# Port for the local server (default 3000)
PORT=3000
